// The window: the readings over the feed in color with what the read sees on top, and the state of
// the read beside them. Pressing flutters by hand has its own small layout. build.rs takes out the blocks
// marked as only for video from the plain build, and the ones marked as plain from the other.
// Colors are AutoSplit's dark theme.

import { Button, CheckBox, ComboBox, Slider } from "std-widgets.slint";

// video {
// In the game's picture, which is 720 by 540 whatever the feed is
export struct GameRect {
    x: float,
    y: float,
    width: float,
    height: float,
}
// } video

// A reading in the list
export struct ReadingRow {
    rank: int,
    share: float,
    chance: string,
    seed: string,
    link: string,
    hits: int,
    misses: int,
    strays: int,
    predicted: int,
    heart-piece: string,
}

global Colors {
    out property <color> reached: #6cd688;
    out property <color> blob: #e0c040;
    out property <color> blinking: #ff7070;
    out property <color> secondary: #a8a8a8;
    out property <color> field: #2d2d2d;
    out property <color> frame: #555555;
    out property <color> bar: #3d9bff;
    out property <color> likely: #e0a040;
    out property <color> card: #272727;
    out property <color> faint: #6a6a6a;
}

// video {
component Mark inherits Rectangle {
    in property <GameRect> rect;
    in property <length> unit;
    in property <color> mark-color;
    in property <length> grow: 0px;
    x: self.rect.x * self.unit - self.grow;
    y: self.rect.y * self.unit - self.grow;
    width: self.rect.width * self.unit + 2 * self.grow;
    height: self.rect.height * self.unit + 2 * self.grow;
    border-width: 2px;
    border-color: self.mark-color;
    background: transparent;
}
// } video

// A count with its name, dimmed at zero
component Tally inherits HorizontalLayout {
    in property <int> count;
    in property <string> name;
    in property <color> tint;
    spacing: 3px;

    Text {
        text: root.count;
        color: root.count == 0 ? Colors.faint : root.tint;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }

    Text {
        text: root.name;
        color: Colors.secondary;
        font-size: 10px;
        vertical-alignment: center;
    }
}

// The time left until the moment to press
component CountdownBox inherits Rectangle {
    in property <string> countdown;
    in property <length> countdown-size: 34px;
    in property <float> share;
    in property <bool> pulse;
    in property <bool> press;
    in property <bool> likely;
    in property <string> likely-text;
    in property <string> margin-text;
    background: self.press ? (self.likely ? Colors.likely : Colors.reached) : self.pulse ? #5a5a5a : Colors.field;
    border-width: 1px;
    border-color: Colors.frame;

    Rectangle {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width * root.share;
        height: 14px;
        background: root.press ? white : root.likely ? Colors.likely : Colors.bar;
    }

    Text {
        y: 6px;
        height: parent.height - 24px;
        text: root.countdown == "" ? "No countdown yet" : root.countdown;
        color: root.press ? black : root.countdown == "" ? Colors.secondary : white;
        font-size: root.countdown == "" ? 14px : root.countdown-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        y: 2px;
        height: 16px;
        text: root.likely-text;
        color: root.press ? black : Colors.likely;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
    }

    Text {
        x: parent.width - self.width - 6px;
        y: 2px;
        height: 16px;
        text: root.margin-text;
        color: root.press ? black : Colors.secondary;
        font-size: 11px;
    }
}

// One possible state of the RNG, in one line. The bar behind it is its chance of being the real one
component CandidateRow inherits Rectangle {
    in property <ReadingRow> reading;
    property <color> accent: self.reading.predicted >= 2 ? Colors.reached : Colors.faint;
    height: 29px;
    border-radius: 4px;
    background: Colors.card;
    clip: true;

    Rectangle {
        x: 0px;
        width: parent.width * root.reading.share;
        background: @linear-gradient(90deg, root.accent.transparentize(0.45), root.accent.transparentize(0.8));
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;

        Text {
            width: 58px;
            text: root.reading.chance;
            color: white;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            alignment: start;

            Tally {
                count: root.reading.hits;
                name: "hit";
                tint: Colors.reached;
            }

            Tally {
                count: root.reading.misses;
                name: "miss";
                tint: Colors.blinking;
            }

            Tally {
                count: root.reading.strays;
                name: "stray";
                tint: Colors.blob;
            }
        }

        Text {
            width: 64px;
            text: root.reading.heart-piece;
            color: white;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// video {
// One of the predictions a reading needs to be proven
component ProofDot inherits Rectangle {
    in property <bool> lit;
    in property <color> tint;
    width: 9px;
    height: 9px;
    border-radius: 4.5px;
    border-width: 1px;
    border-color: self.lit ? self.tint : Colors.faint;
    background: self.lit ? self.tint : transparent;
}

// One possible state of the RNG. The bar behind it is its chance of being the real one, and its
// color says how far it's got: gray searching, blue predicting, green proven
component ReadingCard inherits Rectangle {
    in property <ReadingRow> reading;
    property <color> accent: self.reading.predicted >= 2 ? Colors.reached : self.reading.predicted == 1 ? Colors.bar : Colors.faint;
    height: 40px;
    border-radius: 5px;
    background: Colors.card;
    clip: true;

    Rectangle {
        x: 0px;
        width: parent.width * root.reading.share;
        background: @linear-gradient(90deg, root.accent.transparentize(0.45), root.accent.transparentize(0.8));
    }

    Rectangle {
        x: 0px;
        width: 3px;
        background: root.accent;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;

        Text {
            width: 16px;
            text: root.reading.rank;
            color: Colors.secondary;
            font-size: 11px;
            vertical-alignment: center;
        }

        Text {
            width: 58px;
            text: root.reading.chance;
            color: white;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 4px;
            padding-bottom: 4px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.reading.seed;
                    color: white;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.reading.link;
                    color: Colors.secondary;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Tally {
                    count: root.reading.hits;
                    name: "hit";
                    tint: Colors.reached;
                }

                Tally {
                    count: root.reading.misses;
                    name: "miss";
                    tint: Colors.blinking;
                }

                Tally {
                    count: root.reading.strays;
                    name: "stray";
                    tint: Colors.blob;
                }
            }
        }

        VerticalLayout {
            width: 64px;
            padding-top: 4px;
            padding-bottom: 4px;

            Text {
                text: root.reading.heart-piece;
                color: white;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 3px;
                alignment: end;

                VerticalLayout {
                    alignment: center;

                    ProofDot {
                        lit: root.reading.predicted >= 1;
                        tint: root.accent;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    ProofDot {
                        lit: root.reading.predicted >= 2;
                        tint: root.accent;
                    }
                }
            }
        }
    }
}

// } video

export component MainWindow inherits Window {
    title: "Dampe Calculator";
    // Pressing fits the gap beside a 4:3 game on a 1920x1080 stream, at 4:3 itself
    preferred-width: root.manual ? 480px : 720px;
    preferred-height: root.manual ? 320px : 640px;
    min-width: root.manual ? 480px : 640px;
    max-width: root.manual ? 480px : 100000px;
    min-height: root.manual ? 320px : 560px;
    background: #1f1f1f;

    // video {
    in property <image> feed;
    in property <image> eye-zoom;
    in property <[GameRect]> blobs;
    in property <GameRect> eye;
    in property <bool> has-eye;
    in property <bool> blinking;
    in property <string> status: "Talk to Dampe: reading starts by itself at his first text box";
    // } video
    // plain {
    in property <string> status;
    // } plain
    in property <color> status-color: white;
    in property <string> latest;
    // It's something going wrong
    in property <bool> latest-warning;
    // The last few counts pressed
    in property <string> recent;
    // How far off the moment to press can be
    in property <string> margin-text;
    property <bool> settings-open;
    in property <string> source;
    in property <string> countdown;
    // How close the long beep is: 0 is far away, 1 is now
    in property <float> countdown-share;
    // A flash on each of the last seconds, to get the rhythm of it
    in property <bool> pulse;
    // The moment to press
    in property <bool> press;
    // The countdown is for a press that's probably right, not proven
    in property <bool> likely;
    in property <string> likely-text;
    in-out property <int> platform-index: 1;
    in property <string> timing;
    in-out property <bool> sound-on;
    in-out property <float> volume: 50;
    in property <[string]> log;
    in property <[ReadingRow]> readings;
    in property <string> readings-summary: "It takes a few flutters to start looking";
    // Reading presses, so there's no video to show
    // video {
    in property <bool> manual;
    // } video
    // plain {
    property <bool> manual: true;
    // } plain
    // Flipped to repaint the whole window
    in property <bool> repaint-all;
    in property <bool> global-keys-available;
    // Keys 3 and 4 work from any program, while nothing else gets them
    in-out property <bool> global-keys: true;
    // Room for the frame's thickest border around the picture
    property <length> feed-border: 6px;
    // The list always gets at least this much, for a window that's wide but not tall
    property <length> least-readings: 170px;
    // The key as the window sees it, where it has to listen itself instead of a global hotkey
    in property <string> hotkey-text;

    in property <string> hotkey-name;
    callback start-over();
    callback hotkey-pressed();
    callback flutter-pressed(int);
    callback global-keys-changed(bool);
    callback open-log();
    callback platform-changed();
    callback sound-changed();
    callback volume-released();

    forward-focus: keys;

    keys := FocusScope {
        // Slint's software renderer clears each changed area but draws text across the box around all
        // of them, so with several small changes at once, text ended up over old text. Changing this
        // changes the whole window, which makes it one area. Both are fully transparent: any opacity at
        // all shifts the whole background by a shade, which flickers.
        Rectangle {
            background: root.repaint-all ? #00000000 : #01010100;
        }

        key-pressed(event) => {
            if (root.hotkey-text != "" && event.text == root.hotkey-text) {
                root.hotkey-pressed();
                return accept;
            }
            if (!event.repeat && event.text == "3") {
                root.flutter-pressed(3);
                return accept;
            }
            if (!event.repeat && event.text == "4") {
                root.flutter-pressed(4);
                return accept;
            }
            return reject;
        }

        // video {
        if !root.manual: HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding: 10px;
            spacing: 10px;

            // Children placed by hand, so its size comes from the window and never from what's in it
            left := Rectangle {
                horizontal-stretch: 1;
                min-width: 330px;

                // As wide as there's room for at 4:3, with what's left over it for the readings
                property <length> picture-width: min(self.width - 2 * root.feed-border,
                    (self.height - root.least-readings - 8px - 2 * root.feed-border) * 4 / 3);
                property <length> frame-height: self.picture-width * 3 / 4 + 2 * root.feed-border;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height - parent.frame-height - 8px;
                    clip: true;

                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        HorizontalLayout {
                            height: 18px;

                            Text {
                                text: "Candidates";
                                color: white;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.readings-summary;
                                color: Colors.secondary;
                                font-size: 11px;
                                overflow: elide;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        // Only cards that fit whole: the heading, then a card and its gap each
                        for reading[index] in root.readings: ReadingCard {
                            reading: reading;
                            visible: index < floor((parent.height - 22px) / 44px);
                        }
                    }
                }

                feed-frame := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height;
                    width: left.picture-width + 2 * root.feed-border;
                    height: left.frame-height;
                    background: black;
                    border-width: root.press ? 6px : root.pulse ? 3px : 1px;
                    border-color: root.press ? (root.likely ? Colors.likely : Colors.reached) : root.pulse ? white : Colors.frame;

                    property <length> unit: left.picture-width / 720;

                    Rectangle {
                        x: root.feed-border;
                        y: root.feed-border;
                        width: left.picture-width;
                        height: left.picture-width * 3 / 4;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.feed;
                            image-fit: fill;
                        }

                        for rect in root.blobs: Mark {
                            rect: rect;
                            unit: feed-frame.unit;
                            mark-color: Colors.blob;
                            grow: 1px;
                        }
                        if root.has-eye: Mark {
                            rect: root.eye;
                            unit: feed-frame.unit;
                            mark-color: root.blinking ? Colors.blinking : Colors.reached;
                        }
                    }
                }
            }

            VerticalLayout {
                width: 280px;
                spacing: 8px;

                Text {
                    // Room for 2 lines whatever it says, so nothing below moves
                    height: 48px;
                    text: root.status;
                    color: root.status-color;
                    font-size: 18px;
                    font-weight: 700;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: top;
                }

                Text {
                    height: 18px;
                    text: root.latest;
                    color: Colors.secondary;
                    font-size: 13px;
                    overflow: elide;
                }

                CountdownBox {
                    height: 84px;
                    countdown: root.countdown;
                    share: root.countdown-share;
                    pulse: root.pulse;
                    press: root.press;
                    likely: root.likely;
                    likely-text: root.likely-text;
                }

                Rectangle {
                    min-height: 90px;
                    preferred-height: 190px;
                    background: black;
                    border-width: 2px;
                    border-color: !root.has-eye ? Colors.frame : root.blinking ? Colors.blinking : Colors.reached;

                    Image {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        source: root.eye-zoom;
                        image-fit: contain;
                        image-rendering: pixelated;
                        visible: root.has-eye;
                    }

                    Text {
                        text: "Eye not found yet";
                        color: Colors.secondary;
                        visible: !root.has-eye;
                    }
                }

                Text {
                    height: 16px;
                    text: "Green: eye. Red: changing. Yellow: other changes.";
                    color: Colors.secondary;
                    font-size: 11px;
                    overflow: elide;
                }

                Rectangle {
                    // Shows the newest lines that fit, and never asks for more room than it's given
                    vertical-stretch: 1;
                    min-height: 30px;
                    preferred-height: 30px;
                    background: Colors.field;
                    border-width: 1px;
                    border-color: Colors.frame;
                    clip: true;

                    log-lines := VerticalLayout {
                        x: 6px;
                        y: parent.height - self.height - 4px;
                        width: parent.width - 12px;
                        height: self.preferred-height;

                        for line in root.log: Text {
                            text: line;
                            color: Colors.secondary;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }

                ComboBox {
                    model: ["N64", "Wii VC"];
                    current-index <=> root.platform-index;
                    selected => {
                        root.platform-changed();
                    }
                }

                Text {
                    height: 14px;
                    text: root.timing;
                    color: Colors.secondary;
                    font-size: 11px;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    CheckBox {
                        text: "Sound";
                        horizontal-stretch: 0;
                        checked <=> root.sound-on;
                        toggled => {
                            root.sound-changed();
                        }
                    }

                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 100;
                        enabled: root.sound-on;
                        value <=> root.volume;
                        released(_) => {
                            root.volume-released();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        horizontal-stretch: 1;
                        text: "Force start (" + root.hotkey-name + ")";
                        clicked => {
                            root.hotkey-pressed();
                        }
                    }
                    Button {
                        horizontal-stretch: 1;
                        text: "Start over";
                        clicked => {
                            root.start-over();
                        }
                    }

                    Button {
                        text: "Log";
                        clicked => {
                            root.open-log();
                        }
                    }
                }

                Text {
                    text: "Reading starts by itself at Dampe's first text box. Force start is only for when it doesn't.";
                    color: Colors.secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Text {
                    height: 14px;
                    text: root.source;
                    color: Colors.secondary;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }
        // } video

        // Everything has its place whatever it says, so the countdown never moves
        if root.manual: VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: 10px;
            spacing: 5px;

            Text {
                height: 26px;
                text: root.status;
                color: root.status-color;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }

            HorizontalLayout {
                height: 18px;
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    text: root.latest;
                    color: root.latest-warning ? Colors.likely : Colors.secondary;
                    font-size: 13px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Text {
                    text: root.recent;
                    color: Colors.secondary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            CountdownBox {
                vertical-stretch: 1;
                min-height: 92px;
                countdown: root.countdown;
                countdown-size: 44px;
                share: root.countdown-share;
                pulse: root.pulse;
                press: root.press;
                likely: root.likely;
                likely-text: root.likely-text;
                margin-text: root.margin-text;
            }

            // Help until there are candidates, and settings instead of them when asked for
            Rectangle {
                height: 112px;
                clip: true;

                if !root.settings-open && root.readings.length == 0: Text {
                    width: 100%;
                    height: 100%;
                    text: "Press 3 or 4 for how many blinks, as each flutter (burst of blinks) ends. Press either again within 1.3 s to flip a wrong count.\n\nPress A on Yes when the countdown reaches zero. Start over before each new talk.\n\n" + (root.global-keys && root.global-keys-available ? "Works from any program." : "Keep this window focused.");
                    color: Colors.secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !root.settings-open && root.readings.length > 0: Rectangle {
                    Text {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 16px;
                        text: root.readings-summary;
                        color: Colors.secondary;
                        font-size: 11px;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    // The rest fall outside and get clipped
                    for reading[index] in root.readings: CandidateRow {
                        x: 0px;
                        y: 18px + index * 31px;
                        width: parent.width;
                        reading: reading;
                    }
                }

                if root.settings-open: VerticalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 4px;
                    alignment: center;

                    HorizontalLayout {
                        spacing: 8px;

                        ComboBox {
                            width: 110px;
                            model: ["N64", "Wii VC"];
                            current-index <=> root.platform-index;
                            selected => {
                                root.platform-changed();
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.timing;
                            color: Colors.secondary;
                            font-size: 11px;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Log";
                            clicked => {
                                root.open-log();
                            }
                        }
                    }

                    if root.global-keys-available: CheckBox {
                        text: "Take keys 3 and 4 from all programs";
                        checked <=> root.global-keys;
                        toggled => {
                            root.global-keys-changed(self.checked);
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        CheckBox {
                            text: "Sound";
                            horizontal-stretch: 0;
                            checked <=> root.sound-on;
                            toggled => {
                                root.sound-changed();
                            }
                        }

                        Slider {
                            horizontal-stretch: 1;
                            minimum: 0;
                            maximum: 100;
                            enabled: root.sound-on;
                            value <=> root.volume;
                            released(_) => {
                                root.volume-released();
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 32px;
                spacing: 8px;

                Button {
                    horizontal-stretch: 1;
                    text: root.hotkey-name != "" ? "Start over (" + root.hotkey-name + ")" : "Start over";
                    clicked => {
                        root.start-over();
                    }
                }

                Button {
                    width: 90px;
                    text: root.settings-open ? "Done" : "Settings";
                    clicked => {
                        root.settings-open = !root.settings-open;
                    }
                }
            }
        }
    }
}
